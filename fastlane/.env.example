# Names only. Real values live in the CI secret store / your shell, never in git.

# Android signing (consumed by android/app/build.gradle.kts)
ANDROID_KEYSTORE_PATH=
ANDROID_KEYSTORE_PASSWORD=
ANDROID_KEY_ALIAS=
ANDROID_KEY_PASSWORD=

# Google Play upload
GOOGLE_PLAY_JSON_KEY_PATH=

# iOS signing / App Store Connect (match + API key)
MATCH_GIT_URL=
MATCH_PASSWORD=
APP_STORE_CONNECT_KEY_ID=
APP_STORE_CONNECT_ISSUER_ID=
APP_STORE_CONNECT_KEY_PATH=
TEAM_ID=

# Optional distribution / notifications
FIREBASE_APP_ID=
FIREBASE_CLI_TOKEN=
SLACK_URL=
BROWSERSTACK_USERNAME=
BROWSERSTACK_ACCESS_KEY=
